"text_mentions":[{"pos_start":6136,"pos_end":6137,"markup":271,"original_object_uri":"http://erlangen-crm.org/mainResource/7b8c2e74-b323-468d-91cd-e265bbb7a6b2/edeb4907-f54f-421b-b5e3-3b075607eca1"},{"pos_start":10105,"pos_end":10106,"markup":276,"original_object_uri":"http://erlangen-crm.org/mainResource/7b8c2e74-b323-468d-91cd-e265bbb7a6b2/c2337f12-fd17-4417-9ffc-393136160a5e"},{"pos_start":4003,"pos_end":4004,"markup":277,"original_object_uri":"http://erlangen-crm.org/mainResource/7b8c2e74-b323-468d-91cd-e265bbb7a6b2/1305cb0d-ba2e-4cb7-833b-40efec5ec87a"}]}}},{"id":7077,"pos_start":6122,"pos_end":6122,"node_uri":"http://erlangen-crm.org/mainOntology/b513fa8a-0a17-49c4-8d8a-c80f732f2e86/de9d56e8-b452-4fba-8b54-3d84716ea81a","markup":271,"node":{"id":"http://erlangen-crm.org/mainOntology/b513fa8a-0a17-49c4-8d8a-c80f732f2e86/de9d56e8-b452-4fba-8b54-3d84716ea81a","position":{"x":0,"y":0},"type":"mainNode","data":{"id":"4:22bf3666-b797-44f3-ab4f-ae4db1676bd4:5838","labels":["http://www.w3.org/2002/07/owl#ObjectProperty","http://erlangen-crm.org/mainOntology/b513fa8a-0a17-49c4-8d8a-c80f732f2e86"],"params":["http://www.w3.org/2000/01/rdf-schema#label","uri"],"http://www.w3.org/2000/01/rdf-schema#label":["схема_характеризуется@ru","schema_characterized_by@en"],"uri":"http://erlangen-crm.org/mainOntology/b513fa8a-0a17-49c4-8d8a-c80f732f2e86/de9d56e8-b452-4fba-8b54-3d84716ea81a","ontology_uri":null,"is_toggled":false,"toggled_data":[],"params_values":{"http://www.w3.org/2000/01/rdf-schema#label":["схема_характеризуется@ru","schema_characterized_by@en"],"uri":"http://erlangen-crm.org/mainOntology/b513fa8a-0a17-49c4-8d8a-c80f732f2e86/de9d56e8-b452-4fba-8b54-3d84716ea81a"},"file":null,"connected_file":null,"text_mentions":[{"pos_start":6122,"pos_end":6122,"markup":271,"original_object_uri":"http://erlangen-crm.org/mainResource/7b8c2e74-b323-468d-91cd-e265bbb7a6b2/edeb4907-f54f-421b-b5e3-3b075607eca1"},{"pos_start":6170,"pos_end":6170,"markup":276,"original_object_uri":"http://erlangen-crm.org/mainResource/7b8c2e74-b323-468d-91cd-e265bbb7a6b2/c2337f12-fd17-4417-9ffc-393136160a5e"},{"pos_start":16041,"pos_end":16041,"markup":277,"original_object_uri":"http://erlangen-crm.org/mainResource/7b8c2e74-b323-468d-91cd-e265bbb7a6b2/1305cb0d-ba2e-4cb7-833b-40efec5ec87a"}]}}}],"relations":[{"id":1062,"start":7006,"end":7009,"connection":7038,"markup":271},{"id":1067,"start":7007,"end":7015,"connection":7049,"markup":271},{"id":1071,"start":7006,"end":7019,"connection":7059,"markup":271},{"id":1072,"start":7007,"end":7019,"connection":7059,"markup":271},{"id":1076,"start":7006,"end":7018,"connection":7077,"markup":271}],"originalText":["Матрицы памяти: динамическое и статическое ОЗУ","","В цифровых системах необходимы запоминающие устройства для хранения данных и результатов работы схем. Регистр, состоящий из нескольких триггеров, предназначен для хранения небольших объемов данных. Для эффективного хранения больших объемов данных используются матрицы памяти, реализуемые в виде интегральных схем.","","Память организована как двумерная матрица запоминающих элементов. Содержимое памяти записывается и считывается по строкам. Строка выбирается адресом. Записанные или считанные значения называются словами данных матрицы. Глубина матрицы равна количеству ее строк, а ширина -- количеству столбцов, которое также называется размером слова. Размер матрицы равен произведению количества столбцов на количество строк. Каждый запоминающий элемент соединен с линией слов и линией битов. При любой комбинации адресных битов активируется только одна линия выборки слов, и тем самым разрешается доступ к элементам соответствующей строки. Память может быть классифицирована по способу хранения битов. Основные классы -- оперативные запоминающие устройства (RAM) и постоянные запоминающие устройства (ROM). Основными классами ОЗУ являются динамическое ОЗУ (DRAM) и статическое ОЗУ (SRAM).","","В динамическом ОЗУ (DRAM) значениям битов соответствует наличие и отсутствие заряда конденсатора. N-канальный МОП-транзистор является ключом, который может подключить конденсатор к линии записи/чтения или отключить его. Когда линия выборки слов активна, транзистор включается, и хранимые биты передаются на линию записи/чтения или, наоборот, происходит запись новой информации в элемент. Когда конденсатор заряжен до VDD, хранимый бит равен 1; когда он разряжен до нуля, хранимый бит равен 0. Чтение уничтожает данные, поэтому после каждого чтения данные должны быть восстановлены. Даже если данные не считываются, из-за саморазряда конденсаторов они должны регенерироваться каждые несколько миллисекунд. Микросхема DRAM изготавливается на кремниевой подложке и содержит в своем составе миллиарды n-МОП-транзисторов. Микросхема DRAM характеризуется такими параметрами, как частота работы и напряжение питания. Микросхемы памяти DRAM используются в системах памяти компьютеров, серверов и мобильных устройств.","","Статическое ОЗУ (SRAM) называется статическим, потому что в нем отсутствует необходимость регенерации хранимых данных. Запоминающий элемент статического ОЗУ реализуется в виде бистабильной схемы из перекрестно соединенных инверторов. Каждый инвертор построен из одного n-МОП и одного p-МОП транзистора, то есть логический элемент НЕ является основным строительным блоком ячейки SRAM. Два дополнительных n-МОП-транзистора выполняют функцию ключей доступа. Триггеры, статические и динамические ОЗУ различаются временными характеристиками и площадью чипа, необходимой для хранения одного бита. Динамическое ОЗУ обеспечивает высокую плотность хранения, а статическое ОЗУ обычно быстрее. Микросхемы SRAM характеризуются параметрами быстродействия и применяются в кэш-памяти процессоров и в системах, требующих максимальной скорости доступа к данным. Микросхемы SRAM используются в системах памяти, где критична скорость, а не объем.","","Современные разновидности динамического ОЗУ, такие как SDRAM и DDR SDRAM, были разработаны для повышения пропускной способности. В синхронном динамическом ОЗУ используется тактовый сигнал для конвейеризации доступа к памяти. В стандартах DDR2, DDR3 и DDR4 тактовая частота была увеличена, и к 2012 году она превысила 1 ГГц. Задержка памяти и ее пропускная способность зависят от размера памяти; при прочих равных условиях память большего объема, как правило, работает медленнее, чем меньшая.","","Цифровые системы часто используют несколько регистров для хранения временных переменных. Такие группы регистров, называемые регистровыми файлами, обычно реализуются в виде небольших многопортовых матриц статического ОЗУ, поскольку они более компактны, чем матрицы триггеров. Трехпортовый регистровый файл может иметь два порта для чтения и один порт для записи. Частота работы регистрового файла определяется тактовой частотой процессора.","","В постоянном запоминающем устройстве (ROM) хранимым битовым значениям соответствует наличие или отсутствие транзистора. При чтении информации из элемента на линию записи/чтения от внешнего источника подается слабый уровень логической 1. Если в элементе есть транзистор, он открывается и устанавливает на линии записи/чтения уровень логического 0.","","[Источники: Harris & Harris, гл. 5, §5.5.1--5.5.6, с. 324--330]",""],"textWithIds":{"0":"Матрицы","1":"памяти:","2":"динамическое","3":"и","4":"статическое","5":"ОЗУ","1000":"","2000":"В","2001":"цифровых","2002":"системах","2003":"необходимы","2004":"запоминающие","2005":"устройства","2006":"для","2007":"хранения","2008":"данных","2009":"и","2010":"результатов","2011":"работы","2012":"схем","2013":". ","2014":"Регистр","2015":", ","2016":"состоящий","2017":"из","2018":"нескольких","2019":"триггеров","2020":", ","2021":"предназначен","2022":"для","2023":"хранения","2024":"небольших","2025":"объемов","2026":"данных","2027":". ","2028":"Для","2029":"эффективного","2030":"хранения","2031":"больших","2032":"объемов","2033":"данных","2034":"используются","2035":"матрицы","2036":"памяти","2037":", ","2038":"реализуемые","2039":"в","2040":"ви